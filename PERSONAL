<script>
  /* ===== 打字机 ===== */
  (function(){
    var text = "> freshman / learner / builder — welcome to my page";
    var el = document.getElementById("typeText");
    var i = 0;
    var reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (reduce) { el.textContent = text; return; }
    var timer = setInterval(function(){
      el.textContent = text.slice(0, i++);
      if (i > text.length) { clearInterval(timer); }
    }, 45);
  })();

  /* ===== 滚动揭示 ===== */
  (function(){
    var items = document.querySelectorAll(".reveal");
    if (!("IntersectionObserver" in window)) {
      items.forEach(function(el){ el.classList.add("in"); });
      return;
    }
    var io = new IntersectionObserver(function(entries){
      entries.forEach(function(e){
        if (e.isIntersecting) { e.target.classList.add("in"); io.unobserve(e.target); }
      });
    }, {threshold: 0.12});
    items.forEach(function(el){ io.observe(el); });
  })();

  /* ===== Moments 本地存储 ===== */
  (function(){
    var KEY = "chenleru_moments_v1";
    var list = [];
    try { list = JSON.parse(localStorage.getItem(KEY)) || []; } catch(e) { list = []; }

    var input = document.getElementById("momentInput");
    var btn = document.getElementById("momentBtn");
    var hint = document.getElementById("momentHint");
    var box = document.getElementById("momentList");

    function pad(n){ return n < 10 ? "0" + n : "" + n; }
    function fmt(d){
      return d.getFullYear() + "-" + pad(d.getMonth()+1) + "-" + pad(d.getDate()) + " " + pad(d.getHours()) + ":" + pad(d.getMinutes());
    }
    function save(){
      try { localStorage.setItem(KEY, JSON.stringify(list)); } catch(e) {}
    }
    function render(){
      box.innerHTML = "";
      if (!list.length) {
        var d = document.createElement("div");
        d.className = "empty";
        d.textContent = "还没有记录，写一条试试。";
        box.appendChild(d);
        return;
      }
      list.forEach(function(m, idx){
        var row = document.createElement("div");
        row.className = "moment";
        var date = document.createElement("div");
        date.className = "date";
        date.textContent = m.time;
        var txt = document.createElement("div");
        txt.className = "txt";
        txt.textContent = m.text;
        var del = document.createElement("button");
        del.className = "del";
        del.setAttribute("aria-label", "删除");
        del.textContent = "×";
        del.addEventListener("click", function(){
          list.splice(idx, 1);
          save();
          render();
        });
        row.appendChild(date);
        row.appendChild(txt);
        row.appendChild(del);
        box.appendChild(row);
      });
    }
    btn.addEventListener("click", function(){
      var v = input.value.trim();
      if (!v) { hint.textContent = "先写点什么再记。"; return; }
      list.unshift({ text: v, time: fmt(new Date()) });
      save();
      input.value = "";
      hint.textContent = "已记下（仅保存在这台电脑的浏览器里）";
      render();
    });
    render();
  })();
</script>
</body>
</html>
